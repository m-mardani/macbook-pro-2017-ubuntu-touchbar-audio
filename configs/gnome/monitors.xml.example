<!--
  ~/.config/monitors.xml for a MacBook Pro whose internal panel is gone but is
  still reported as connected (eDP-1).

  One <configuration> per USB-C output, so the layout holds whichever port the
  monitor is plugged into. Connector names DP-3..DP-6 are what the AMD GPU
  exposes on a MacBookPro14,3; check yours:
      ls /sys/class/drm/

  Replace VENDOR / PRODUCT / SERIAL and the mode with the values GNOME wrote
  for your own monitor (Settings -> Displays writes this file), then repeat the
  block for the other connectors.

  Login screen copy (GDM 50, Ubuntu 26.04): /var/lib/gdm3/seat0/config/monitors.xml
-->
<monitors version="2">
  <configuration>
    <layoutmode>logical</layoutmode>
    <logicalmonitor>
      <x>0</x>
      <y>0</y>
      <scale>1</scale>
      <primary>yes</primary>
      <monitor>
        <monitorspec>
          <connector>DP-3</connector>
          <vendor>VENDOR</vendor>
          <product>PRODUCT</product>
          <serial>SERIAL</serial>
        </monitorspec>
        <mode>
          <width>1920</width>
          <height>1080</height>
          <rate>60.000</rate>
        </mode>
      </monitor>
    </logicalmonitor>
    <disabled>
      <monitorspec>
        <connector>eDP-1</connector>
        <vendor>APP</vendor>
        <product>Color LCD</product>
        <serial>0x00000000</serial>
      </monitorspec>
    </disabled>
  </configuration>
  <!-- repeat the <configuration> block with DP-4, DP-5 and DP-6 -->
</monitors>
